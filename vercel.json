
{
  "rewrites": [
    {
      "source": "/api/music/:path*",
      "destination": "https://rushicdhande.vercel.app/api/music/:path*"
    },
    {
      "source": "/in/song/:slug/:id",
      "destination": "/index.html"
    },
    {
      "source": "/in/song/:id",
      "destination": "/index.html"
    },
    {
      "source": "/in/album/:slug/:id",
      "destination": "/index.html"
    },
    {
      "source": "/in/album/:id",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
